      {
        "parameters": {
          "jsCode": "// Normalisasi payload batch dari Webhook\nconst raw = $('Webhook Konten Sawit').first().json || {};\nconst body = raw.body ? raw.body : raw;\nconst items = Array.isArray(body.items) ? body.items : (Array.isArray(body) ? body : [body]);\n\nconst formattedItems = [];\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i];\n  if (!row || (!row.topic_or_prompt && !row.generated_caption)) continue;\n  \n  formattedItems.push({\n    json: {\n      id: row.id || `SSN-${Date.now()}-${i + 1}`,\n      topic_or_prompt: row.topic_or_prompt || '',\n      post_type: (row.post_type || 'TEXT').toString().trim().toUpperCase(),\n      scheduled_time: row.scheduled_time || '',\n      generated_caption: row.generated_caption || '',\n      media_url: row.media_url || '',\n      link_url: row.link_url || '',\n      status: (row.status || 'READY').toString().trim().toUpperCase(),\n      fb_post_id: '',\n      fb_post_url: '',\n      error_log: ''\n    }\n  });\n}\n\nreturn formattedItems;"
        },
