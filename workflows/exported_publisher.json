[{"updatedAt":"2026-09-29T08:17:36.808Z","createdAt":"2026-09-29T07:20:27.938Z","id":"r3MrzlzaaaL2yQDX","name":"01_Facebook_Page_Auto_Publisher_PRO","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"content":"### ⏰ 1. Pemicu Jadwal (Cron)\nWorkflow ini memeriksa Google Sheets secara otomatis setiap 15 menit untuk mencari postingan yang sudah waktunya tayang.","height":260,"width":260,"color":4},"id":"f3ff7597-76b8-44bc-b81c-746567bcfdd9","name":"Note 1: Jadwal","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[144,624]},{"parameters":{"content":"### ⚙️ 2. Kredensial & Pengaturan\nData Halaman **Solusi Sawit Nusantara** dan ID Google Sheet Anda sudah diisikan otomatis di sini.","height":260,"width":260,"color":6},"id":"d881a4dc-7f5b-46f7-9a10-36f04e4eee5d","name":"Note 2: Config","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[432,624]},{"parameters":{"content":"### 📊 3. Ambil & Filter Data\nMengambil baris dari Google Sheets dengan kriteria:\n1. Status = 'READY'\n2. scheduled_time <= Waktu Sekarang","height":260,"width":460,"color":5},"id":"430b7e95-0bf9-4bde-8ea4-ddb2e9801be1","name":"Note 3: Sheets & Filter","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[704,624]},{"parameters":{"content":"### 🌐 4. Router & Meta Graph API (v21.0)\nMengarahkan tipe postingan:\n- **IMAGE** -> POST /photos (Gambar + Caption)\n- **LINK** -> POST /feed (Link URL + Teks)\n- **TEXT** -> POST /feed (Pesan Teks)","height":450,"width":450,"color":2},"id":"8b2ed8f7-e8a7-445a-a24c-43af21324c40","name":"Note 4: Meta Graph API","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1184,624]},{"parameters":{"content":"### ✅ 5. Update Status & URL Postingan\nSetelah tayang di Facebook:\n- Mengubah status menjadi 'PUBLISHED'\n- Mencatat tautan langsung postingan ke Google Sheets\n- Mencatat pesan error jika ada kendala","height":260,"width":440,"color":7},"id":"c485df0f-1196-4906-b135-786f8a7372a2","name":"Note 5: Response Update","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[1664,624]},{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"id":"32cf3ef9-fcc9-48f2-a52b-f9bb8a6d1118","name":"Schedule Trigger (Setiap 15 Menit)1","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[192,928]},{"parameters":{"assignments":{"assignments":[{"id":"cfg-1","name":"fb_page_id","value":"1340652705797853","type":"string"},{"id":"cfg-2","name":"fb_page_access_token","value":"EAAO5BE6BfJMBSiCZCVAlCQCztmzTpjaAjYtMDg0zk2eCq1yb5u4SbzDNNvZCbR58B5blKMlxdlTyGKEPHS6ShZC0EsITtSCfZAtjFRVZCamxEMgnaBEtDLZCDxzkZC8jWZAtm2lNBZAZCO7SuMRZBCCAy2phYwDw2iIXbMrURbxZBvOZCSIk4XpWJYfE9eWsZAHH6yjvMkFw5kT0568rJ6gtpUZAzqUTZAvJmZCsbmEOrTrf1LBhh","type":"string"},{"id":"cfg-3","name":"google_sheet_id","value":"16-6Y49K77YOD17V6eaqk0IdvVRyRP4K7hcxqQf-s3WQ","type":"string"},{"id":"cfg-4","name":"sheet_name","value":"ContentQueue","type":"string"}]},"options":{}},"id":"8ec4aefc-5bd7-4ed8-92aa-70e2fe816e69","name":"Set Config & Credentials1","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[464,928]},{"parameters":{"documentId":{"__rl":true,"value":"={{ $('Set Config & Credentials1').item.json.google_sheet_id }}","mode":"id"},"sheetName":{"__rl":true,"value":"ContentQueue","mode":"name"},"options":{}},"id":"63fc23fd-a367-4f83-9575-b43a4f1c72bb","name":"Ambil Data Google Sheets1","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[752,928],"credentials":{"googleSheetsOAuth2Api":{"id":"8zUZsfPdlq7P4Tbc","name":"Google Sheets account"}}},{"parameters":{"jsCode":"// Logika Filter Standar Industri Media Sosial:\n// 1. Baris harus berstatus 'READY'\n// 2. Waktu terjadwal (scheduled_time) harus sudah tiba / terlewat dari waktu saat ini\n\nconst now = new Date();\nconst validItems = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  \n  // Hanya proses baris yang siap\n  if (!row.status || row.status.trim().toUpperCase() !== 'READY') {\n    continue;\n  }\n  \n  const timeStr = row.scheduled_time;\n  if (!timeStr) continue;\n  \n  const scheduledTime = new Date(timeStr.replace(' ', 'T'));\n  \n  if (scheduledTime <= now) {\n    const caption = row.generated_caption || row.topic_or_prompt || '';\n    validItems.push({\n      json: {\n        ...row,\n        final_caption: caption,\n        post_type: (row.post_type || 'TEXT').trim().toUpperCase()\n      }\n    });\n  }\n}\n\nreturn validItems;"},"id":"800ad0a2-469d-4f8a-b739-3b0ce42d6818","name":"Filter Jadwal & Validasi1","type":"n8n-nodes-base.code","typeVersion":2,"position":[976,928]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.post_type }}","rightValue":"IMAGE","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Image Post"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"leftValue":"={{ $json.post_type }}","rightValue":"LINK","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"Link Post"}]},"options":{"fallbackOutput":"extra"}},"id":"6f919a44-a038-4a1f-a63b-4036715b3671","name":"Switch Post Type1","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[1232,928]},{"parameters":{"method":"POST","url":"=https://graph.facebook.com/v21.0/{{ $('Set Config & Credentials1').item.json.fb_page_id }}/photos","sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $('Set Config & Credentials1').item.json.fb_page_access_token }}"},{"name":"url","value":"={{ $json.media_url }}"},{"name":"caption","value":"={{ $json.final_caption }}"}]},"options":{}},"id":"c102cc7b-bb2f-4c30-8f88-bf7683df128d","name":"Post Image ke FB Page1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1456,784],"onError":"continueRegularOutput"},{"parameters":{"method":"POST","url":"=https://graph.facebook.com/v21.0/{{ $('Set Config & Credentials1').item.json.fb_page_id }}/feed","sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $('Set Config & Credentials1').item.json.fb_page_access_token }}"},{"name":"message","value":"={{ $json.final_caption }}"},{"name":"link","value":"={{ $json.link_url }}"}]},"options":{}},"id":"a282fb20-4f77-4fd6-a012-23922110f6f3","name":"Post Link ke FB Page1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1456,928],"onError":"continueRegularOutput"},{"parameters":{"method":"POST","url":"=https://graph.facebook.com/v21.0/{{ $('Set Config & Credentials1').item.json.fb_page_id }}/feed","sendQuery":true,"queryParameters":{"parameters":[{"name":"access_token","value":"={{ $('Set Config & Credentials1').item.json.fb_page_access_token }}"},{"name":"message","value":"={{ $json.final_caption }}"}]},"options":{}},"id":"dab524ef-df3b-41a4-ae98-6ce281bd08ad","name":"Post Text ke FB Page1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1456,1072],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"// Tangani respon Meta Graph API untuk menentukan status sukses atau gagal secara presisi\nconst res = $input.item.json;\nconst row = $('Filter Jadwal & Validasi1').item.json;\n\nif (res.error) {\n  return {\n    id: row.id,\n    status: 'FAILED',\n    fb_post_id: '',\n    fb_post_url: '',\n    error_log: `${res.error.message} (Code: ${res.error.code})`\n  };\n} else if (res.post_id || res.id) {\n  const postId = res.post_id || res.id;\n  return {\n    id: row.id,\n    status: 'PUBLISHED',\n    fb_post_id: postId,\n    fb_post_url: `https://facebook.com/${postId}`,\n    error_log: ''\n  };\n} else {\n  return {\n    id: row.id,\n    status: 'FAILED',\n    fb_post_id: '',\n    fb_post_url: '',\n    error_log: 'Respon tidak terduga dari Facebook API'\n  };\n}"},"id":"0a92cb1e-83b4-4e5d-a06c-4d951119261b","n