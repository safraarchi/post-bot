    {
      "parameters": {
        "jsCode": "// Tangani respon Meta Graph API untuk menentukan status sukses atau gagal secara presisi\nconst res = $input.item.json;\nconst row = $('Filter Jadwal & Validasi').item.json;\n\nif (res.error) {\n  return {\n    id: row.id,\n    status: 'FAILED',\n    fb_post_id: '',\n    fb_post_url: '',\n    error_log: `${res.error.message} (Code: ${res.error.code})`\n  };\n} else if (res.post_id || res.id) {\n  const postId = res.post_id || res.id;\n  return {\n    id: row.id,\n    status: 'PUBLISHED',\n    fb_post_id: postId,\n    fb_post_url: `https://facebook.com/${postId}`,\n    error_log: ''\n  };\n} else {\n  return {\n    id: row.id,\n    status: 'FAILED',\n    fb_post_id: '',\n    fb_post_url: '',\n    error_log: 'Respon tidak terduga dari Facebook API'\n  };\n}"
      },
