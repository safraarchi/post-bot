    {
      "parameters": {
        "jsCode": "// Logika Filter Standar Industri Media Sosial:\n// 1. Baris harus berstatus 'READY'\n// 2. Waktu terjadwal (scheduled_time) harus sudah tiba / terlewat dari waktu saat ini\n\nconst now = new Date();\nconst allItems = $input.all();\nconst validItems = [];\n\nfor (const item of allItems) {\n  const row = item.json;\n  const status = (row.status || '').toString().trim().toUpperCase();\n  \n  // Hanya proses baris yang siap diterbitkan\n  if (status !== 'READY') {\n    continue;\n  }\n  \n  const timeStr = row.scheduled_time;\n  if (!timeStr) continue;\n  \n  // Tangani berbagai variasi format tanggal (ISO, spasi, atau timestamp)\n  let scheduledTime = new Date(timeStr);\n  if (isNaN(scheduledTime.getTime())) {\n    scheduledTime = new Date(timeStr.toString().replace(' ', 'T'));\n  }\n  \n  if (isNaN(scheduledTime.getTime())) {\n    continue;\n  }\n  \n  if (scheduledTime <= now) {\n    const caption = row.generated_caption || row.topic_or_prompt || '';\n    validItems.push({\n      json: {\n        ...row,\n        final_caption: caption,\n        post_type: (row.post_type || 'TEXT').toString().trim().toUpperCase()\n      }\n    });\n  }\n}\n\nreturn validItems;"
      },
      "id": "1e9d1a20-3b4c-4d5e-8f6a-112233445504",
      "name": "Filter Jadwal & Validasi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        480
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.post_type }}",
                    "rightValue": "IMAGE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Image Post"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.post_type }}",
                    "rightValue": "LINK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Link Post"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
