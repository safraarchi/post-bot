# ==========================================
# Konfigurasi n8n & Facebook Auto-Posting
# ==========================================

# 1. Konfigurasi Facebook (Meta Graph API)
# ID Facebook Page Anda (dapat dilihat di info Halaman Facebook)
FB_PAGE_ID=your_facebook_page_id_here

# Permanent Page Access Token (Never-expiring token dari Meta for Developers)
FB_PAGE_ACCESS_TOKEN=your_permanent_page_access_token_here

# 2. Konfigurasi Google Sheets
# ID Dokumen Google Spreadsheet (ada di URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SHEET_NAME=ContentQueue

# 3. Konfigurasi AI (Pilih salah satu atau keduanya)
# Google Gemini API Key (Dapat diperoleh gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Opsional jika menggunakan GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# 4. n8n Security & Webhook Setup
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
